        "outputId": "21d96393-5bad-43d7-bf86-f2fd4d79aa6b"
      },
      "source": [
        "# Régénération de la Figure 7 (Validation des Clusters) avec titres\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 9))\n",
        "fig.suptitle(\"Figure 7: Cluster Validation Metrics (k=2 to k=6)\", fontsize=13, fontweight='bold', y=0.98)\n",
        "\n",
        "metric_names = [\"Silhouette Score (higher is better)\", \"Davies-Bouldin Index (lower is better)\", \"Calinski-Harabasz Index (higher is better)\", \"Adjusted Rand Index with K-Means\"]\n",
        "for ax, (vals, col, name) in zip(axes.flat, [(sils, STEEL, metric_names[0]), (dbs, RED, metric_names[1]), (chs, GREEN, metric_names[2]), (aris, INDIGO, metric_names[3])]):\n",
        "    ax.plot(ks, vals, \"o-\", color=col, lw=2, ms=8)\n",
        "    ax.axvline(4, color=GREY, lw=1.5, linestyle=\"--\", label=\"k=4 selected\")\n",
        "    ax.set_xlabel(\"Number of clusters k\")\n",
        "    ax.set_title(name, fontsize=10)\n",
        "    ax.set_xticks(ks)\n",
        "    ax.legend(fontsize=8)\n",
        "    idx4 = ks.index(4)\n",
        "    ax.annotate(f\"{vals[idx4]:.3f}\", xy=(4, vals[idx4]), xytext=(4.2, vals[idx4]), fontsize=9, color=col)\n",
        "\n",
        "save(\"fig07_cluster_validation\")"
      ],
      "execution_count": 40,
      "outputs": [
