      "source": [
        "# Supprime le cache de polices de Matplotlib et force une reconstruction\n",
        "!rm -rf ~/.cache/matplotlib\n",
        "print(\"Cache de polices Matplotlib supprimé. Veuillez redémarrer l'environnement d'exécution (Runtime > Restart runtime) et réexécuter toutes les cellules.\")"
      ],
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Cache de polices Matplotlib supprimé. Veuillez redémarrer l'environnement d'exécution (Runtime > Restart runtime) et réexécuter toutes les cellules.\n"
