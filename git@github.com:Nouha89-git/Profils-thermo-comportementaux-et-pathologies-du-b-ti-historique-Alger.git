        "outputId": "2a8525b1-b0cb-48db-bf70-c822ac77c448"
      },
      "source": [
        "# Régénération de la Figure 3 (Confort et comportements) avec titres\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 11))\n",
        "fig.suptitle(\"Figure 3: Thermal Comfort and Adaptive Behaviors\", fontsize=14, fontweight='bold', y=0.98)\n",
        "\n",
        "# Graphe 1 : Score de confort thermique\n",
        "axes[0,0].hist(df[\"comfort_score\"].dropna(), bins=10, color=INDIGO, edgecolor=\"white\")\n",
        "axes[0,0].axvline(df[\"comfort_score\"].mean(), color=RED, lw=1.5, linestyle=\"--\", label=f\"Mean={df['comfort_score'].mean():.2f}\")\n",
        "axes[0,0].set_xlabel(\"Thermal comfort score (0-10)\")\n",
        "axes[0,0].legend(fontsize=8)\n",
        "axes[0,0].set_title(\"Thermal Comfort Score\")\n",
        "\n",
        "# Graphe 2 : Satisfaction été vs hiver\n",
        "order = [\"-2 dissatisfied\",\"-1 Somewhat dissatisfied\",\"0 Acceptable\", \"+1 Somewhat satisfied\",\"+2 Satisfied\"]\n",
        "x = np.arange(5)\n",
        "w = 0.35\n",
        "sc = [df[\"sat_summer\"].value_counts().get(o,0) for o in order]\n",
        "wc = [df[\"sat_winter\"].value_counts().get(o,0) for o in order]\n",
        "axes[0,1].bar(x-w/2, sc, w, label=\"Summer\", color=RED, edgecolor=\"white\")\n",
        "axes[0,1].bar(x+w/2, wc, w, label=\"Winter\", color=STEEL, edgecolor=\"white\")\n",
        "axes[0,1].set_xticks(x)\n",
        "axes[0,1].set_xticklabels([\"-2\",\"-1\",\"0\",\"+1\",\"+2\"])\n",
        "axes[0,1].legend()\n",
        "axes[0,1].set_title(\"Thermal Satisfaction (Summer vs. Winter)\")\n",
        "\n",
        "# Graphe 3 : Comportements en été\n",
        "beh_s = {\"Fan/AC\":\"beh_fan_ac\",\"Close shutters\":\"beh_close_shutters\", \"Open windows\":\"beh_open_windows\",\"Light clothes\":\"beh_light_clothes\"}\n",
        "beh_s = {k:v for k,v in beh_s.items() if v in df.columns}\n",
        "pcts_s = [df[col].mean()*100 for col in beh_s.values()]\n",
        "bars3 = axes[1,0].barh(list(beh_s.keys()), pcts_s, color=RED, edgecolor=\"white\")\n",
        "for bar,p in zip(bars3,pcts_s):\n",
        "    axes[1,0].text(p+0.5, bar.get_y()+bar.get_height()/2, f\"{p:.1f}%\", va=\"center\", fontsize=9)\n",
        "axes[1,0].set_xlim(0,110)\n",
        "axes[1,0].set_title(\"Summer Adaptive Behaviors\")\n",
        "\n",
        "# Graphe 4 : Comportements en hiver\n",
        "beh_w = {\"Turn on heating\":\"beh_heating\",\"Warmer clothes\":\"beh_warm_clothes\", \"Close windows\":\"beh_close_windows\"}\n",
        "pcts_w = [df[col].mean()*100 for col in beh_w.values()]\n",
        "bars4 = axes[1,1].barh(list(beh_w.keys()), pcts_w, color=STEEL, edgecolor=\"white\")\n",
        "for bar,p in zip(bars4,pcts_w):\n",
        "    axes[1,1].text(p+0.5, bar.get_y()+bar.get_height()/2, f\"{p:.1f}%\", va=\"center\", fontsize=9)\n",
        "axes[1,1].set_xlim(0,110)\n",
        "axes[1,1].set_title(\"Winter Adaptive Behaviors\")\n",
        "\n",
        "save(\"fig03_thermal_comfort_behaviors\")"
      ],
      "execution_count": 36,
