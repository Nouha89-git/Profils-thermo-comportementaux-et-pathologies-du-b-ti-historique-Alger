      "source": [
        "# Régénération de la Figure 6 (ACM Individuals Map) avec titres\n",
        "fig, ax = plt.subplots(figsize=(10, 7.5))\n",
        "ax.axhline(0, color=GREY, lw=0.4, alpha=0.4)\n",
        "ax.axvline(0, color=GREY, lw=0.4, alpha=0.4)\n",
        "ax.scatter(F[:, 0], F[:, 1], color=INDIGO, s=35, alpha=0.5, edgecolors=\"white\", lw=0.3, label=f\"N={N_MCA} households\")\n",
        "ax.set_xlabel(f\"Dimension 1 ({ep[0]:.1f}%)\")\n",
        "ax.set_ylabel(f\"Dimension 2 ({ep[1]:.1f}%)\")\n",
        "ax.legend(fontsize=9)\n",
        "ax.set_title(\"Figure 6: MCA Individual Factor Map (Cloud of Households)\", fontsize=12, fontweight='bold', pad=15)\n",
        "\n",
        "save(\"fig06_mca_individual_map\")"
      ],
