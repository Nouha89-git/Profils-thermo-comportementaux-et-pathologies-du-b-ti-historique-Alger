    {
      "cell_type": "code",
      "source": [
        "#Load + Clean\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def save(name):\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"/content/{name}.png\", format=\"png\", bbox_inches=\"tight\", dpi=150)\n",
        "    plt.close() # Close the figure to avoid displaying it multiple times in the notebook output\n",
        "    print(f\"saved: /content/{name}.png\")\n",
        "\n",
        "# Plot 1: Gender\n",
        "fig1, ax1 = plt.subplots(figsize=(6, 6))\n",
        "vc_gender = df[\"gender\"].value_counts()\n",
        "ax1.pie(vc_gender.values, labels=vc_gender.index, autopct=\"%1.1f%%\",\n",
        "        colors=[STEEL, RED, PURPLE, GREEN], startangle=90) # Correction: Utilisation des variables de couleurs et correction de la concaténation.\n",
        "save(\"fig01\")\n",
        "\n",
        "# Plot 2: Occupant Status\n",
        "fig2, ax2 = plt.subplots(figsize=(8, 4))\n",
        "vc_occupant = df[\"occupant_status\"].value_counts()\n",
        "bars_occupant = ax2.barh(vc_occupant.index, vc_occupant.values, color=NAVY, edgecolor=\"white\") # Correction: Utilisation de la variable NAVY.\n",
        "for bar, v in zip(bars_occupant, vc_occupant.values):\n",
        "    ax2.text(v + 0.3, bar.get_y() + bar.get_height() / 2, f\"{v} ({100 * v / 125:.1f}%)\", va=\"center\", fontsize=8)\n",
        "ax2.set_xlim(0, vc_occupant.max() * 1.35)\n",
        "save(\"fig02\")\n",
        "\n",
        "# Plot 3: Age Distribution\n",
        "fig3, ax3 = plt.subplots(figsize=(8, 5))\n",
        "ax3.hist(df[\"age\"].dropna(), bins=10, color=GREEN, edgecolor=\"white\") # Correction: Utilisation de la variable GREEN.\n",
        "ax3.axvline(df[\"age\"].mean(), color=\"red\", lw=1.5, linestyle=\"--\",\n",
        "            label=f\"Mean={df['age'].mean():.1f} yr\")\n",
        "ax3.set_xlabel(\"Age (years)\")\n",
        "ax3.legend(fontsize=8)\n",
        "save(\"fig03\")\n",
        "\n",
        "# Plot 4: Apartment Size\n",
        "fig4, ax4 = plt.subplots(figsize=(8, 5))\n",
        "ax4.hist(df[\"area\"].dropna(), bins=10, color=RED, edgecolor=\"white\") # Correction: Utilisation de la variable RED.\n",
        "ax4.axvline(df[\"area\"].mean(), color=\"blue\", lw=1.5, linestyle=\"--\",\n",
        "            label=f\"Mean={df['area'].mean():.0f} m2\")\n",
        "ax4.set_xlabel(\"Floor area (m2)\")\n",
        "ax4.set_title(\"Apartment Size\")\n",
        "ax4.legend(fontsize=8)\n",
        "save(\"fig04\")\n",
        "\n",
        "# Plot 5: Occupation Duration\n",
        "fig5, ax5 = plt.subplots(figsize=(8, 5))\n",
        "ax5.hist(df[\"occ_years\"].dropna(), bins=10, color=PURPLE, edgecolor=\"white\") # Correction: Utilisation de la variable PURPLE.\n",
        "ax5.axvline(df[\"occ_years\"].mean(), color=\"red\", lw=1.5, linestyle=\"--\",\n",
        "            label=f\"Mean={df['occ_years'].mean():.1f} yr\")\n",
        "ax5.set_xlabel(\"Years of occupation\")\n",
        "ax5.set_title(\"Occupation Duration\")\n",
        "ax5.legend(fontsize=8)\n",
        "save(\"fig05\")\n",
        "\n",
        "# Plot 6: Floor Distribution\n",
        "fig6, ax6 = plt.subplots(figsize=(8, 5))\n",
        "vc_floor = df[\"floor\"].value_counts().sort_index()\n",
        "ax6.bar(vc_floor.index.astype(str), vc_floor.values, color=STEEL, edgecolor=\"white\") # Correction: Utilisation de la variable STEEL.\n",
        "ax6.set_xlabel(\"Floor level\")\n",
        "ax6.set_title(\"Floor Distribution\")\n",
        "save(\"fig06\")"
      ],
