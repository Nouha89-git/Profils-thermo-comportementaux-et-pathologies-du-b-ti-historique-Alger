        "    ax.set_xlabel(f\"Dim 1 — {ep[0]:.1f}%\", fontsize=10)\n",
        "    ax.set_ylabel(f\"Dim 2 — {ep[1]:.1f}%\", fontsize=10)\n",
        "    ax.legend(fontsize=8, loc=\"upper right\", framealpha=0.9)\n",
        "\n",
        "save(\"fig08b_individual_map_CAH_vs_KMeans\")\n",
        "\n",
        "\n",
        "# ── Version 3 : individual map + variable map overlay (biplot complet) ───────\n",
        "# Requires G and mods from CELL 7\n",
        "\n",
        "gc = {\n",
        "    \"Sensation\":RED,\"Sat_Summer\":RED,\"Sat_Winter\":RED,\n",
        "    \"Fan_AC\":GREEN,\"Shutters\":GREEN,\"WinOpen\":GREEN,\n",
        "    \"Heating\":GREEN,\"WarmClothes\":GREEN,\"WinClose\":GREEN,\n",
        "    \"Air_Infiltr\":STEEL,\"Water_Infiltr\":STEEL,\n",
        "    \"Moisture\":STEEL,\"ColdDrafts\":STEEL,\n",
        "    \"Glazing\":\"#888888\",\"Shutter_State\":\"#888888\",\"Roof_State\":\"#888888\",\n",
        "}\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(13, 9))\n",
        "ax.axhline(0, color=\"grey\", lw=0.5, alpha=0.3, zorder=0)\n",
        "ax.axvline(0, color=\"grey\", lw=0.5, alpha=0.3, zorder=0)\n",
        "\n",
        "# Individual points (background, faint)\n",
        "for cl in range(K4):\n",
        "    mask = cah_lab == cl\n",
        "    ax.scatter(\n",
        "        F[mask, 0], F[mask, 1],\n",
        "        color=PAL[cl], s=30, alpha=0.30,\n",
        "        edgecolors=\"none\", zorder=1\n",
        "    )\n",
        "\n",
        "# Centroids (prominent)\n",
        "for cl in range(K4):\n",
        "    mask = cah_lab == cl\n",
        "    cx, cy = F[mask, 0].mean(), F[mask, 1].mean()\n",
        "    ax.scatter(cx, cy, color=PAL[cl], marker=\"*\",\n",
        "               s=450, zorder=7, edgecolors=\"black\", lw=0.8,\n",
        "               label=f\"C{cl} centroid — {CLUSTER_NAMES[cl].split('—')[1].strip()}\")\n",
        "    ax.annotate(\n",
        "        f\"C{cl}\",\n",
        "        xy=(cx, cy), xytext=(cx + 0.013, cy + 0.007),\n",
        "        fontsize=10, color=PAL[cl], fontweight=\"bold\",\n",
        "        bbox=dict(boxstyle=\"round,pad=0.25\", fc=\"white\", alpha=0.8, ec=PAL[cl])\n",
        "    )\n",
        "\n",
        "# Modality points (overlay)\n",
        "scale = 0.7   # scale modalities to fit with individual scores\n",
        "for mod, d1, d2 in zip(mods, G[:, 0] * scale, G[:, 1] * scale):\n",
        "    grp = next((g for g in gc if mod.startswith(g)), \"Glazing\")\n",
        "    col = gc.get(grp, \"#888888\")\n",
        "    ax.scatter(d1, d2, color=col, s=60, marker=\"D\",\n",
        "               zorder=4, alpha=0.75, edgecolors=\"white\", lw=0.3)\n",
        "    if abs(d1) > 0.04 or abs(d2) > 0.04:\n",
        "        lbl = mod.split(\"_\")[-1] if \"_\" in mod else mod\n",
        "        ax.annotate(\n",
        "            lbl, (d1, d2), fontsize=6.5, color=col,\n",
        "            xytext=(3, 2), textcoords=\"offset points\"\n",
        "        )\n",
        "\n",
        "# Legend\n",
        "legend_patches = [\n",
        "    mpatches.Patch(color=PAL[cl],\n",
        "                   label=f\"C{cl} — {CLUSTER_NAMES[cl].split('—')[1].strip()} \"\n",
        "                         f\"(n={( cah_lab==cl).sum()})\")\n",
        "    for cl in range(K4)\n",
        "] + [\n",
        "    mpatches.Patch(color=\"#D04B2F\", label=\"◆ Comfort/sensation modalities\"),\n",
        "    mpatches.Patch(color=\"#2E9E6B\", label=\"◆ Adaptive behavior modalities\"),\n",
        "    mpatches.Patch(color=\"#1A5FA8\", label=\"◆ Envelope pathology modalities\"),\n",
        "    mpatches.Patch(color=\"#888888\", label=\"◆ Architecture modalities\"),\n",
        "]\n",
        "ax.legend(handles=legend_patches, fontsize=7.5, loc=\"upper right\",\n",
        "          framealpha=0.9, edgecolor=\"grey\", ncol=2)\n",
        "\n",
        "ax.set_xlabel(f\"Dimension 1 — {ep[0]:.1f}% of inertia\", fontsize=11)\n",
        "ax.set_ylabel(f\"Dimension 2 — {ep[1]:.1f}% of inertia\", fontsize=11)\n",
        "save(\"fig08c_biplot_individuals_modalities_centroids\")\n",
        "\n",
        "print(\"\\nThree figures generated:\")\n",
        "print(\"  fig08a — Individual map CAH with centroids (publication-ready)\")\n",
        "print(\"  fig08b — Individual map CAH vs K-Means side by side\")\n",
        "print(\"  fig08c — Full biplot: individuals + modalities + centroids\")\n"
      ],
