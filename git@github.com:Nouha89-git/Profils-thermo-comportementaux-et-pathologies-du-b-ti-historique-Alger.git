        "    jx = F[mask, 0] + np.random.normal(0, 0.002, mask.sum())\n",
        "    jy = F[mask, 1] + np.random.normal(0, 0.002, mask.sum())\n",
        "    ax.scatter(jx, jy, color=PAL[cl], s=45, alpha=0.65,\n",
        "               edgecolors=\"white\", lw=0.3,\n",
        "               label=f\"C{cl} — {CLUSTER_NAMES[cl].split('—')[1].strip()} (n={mask.sum()})\")\n",
        "\n",
        "    # Centroid\n",
        "    ax.scatter(cx, cy, color=PAL[cl], marker=\"*\",\n",
        "               s=350, zorder=6, edgecolors=\"black\", lw=0.8)\n",
        "\n",
        "    # Centroid label\n",
        "    ax.annotate(\n",
        "        f\"C{cl}\\n({cx:.2f}, {cy:.2f})\",\n",
        "        xy=(cx, cy),\n",
        "        xytext=(cx + 0.015, cy + 0.008),\n",
        "        fontsize=8, color=PAL[cl], fontweight=\"bold\",\n",
        "        bbox=dict(boxstyle=\"round,pad=0.2\", fc=\"white\", alpha=0.7, ec=PAL[cl])\n",
