    {
      "cell_type": "code",
      "source": [
        "# ── CELL FINAL ── Display + Download all figures ─────────────────────────────\n",
        "\n",
        "from IPython.display import Image, display\n",
        "from google.colab import files\n",
        "import os\n",
        "\n",
        "# ── Complete figure inventory ─────────────────────────────────────────────────\n",
        "ALL_FIGURES = [\n",
        "    # name                              title\n",
        "    (\"fig01_respondent_profile\",        \"Fig 1  — Respondent Profile & Housing Characteristics\"),\n",
        "    (\"fig02_architecture_envelope\",     \"Fig 2  — Architectural Characteristics & Envelope Pathologies\"),\n",
        "    (\"fig03_thermal_comfort_behaviors\", \"Fig 3  — Thermal Comfort & Adaptive Behaviors\"),\n",
        "    (\"fig04_mca_scree_plot\",            \"Fig 4  — MCA Scree Plot\"),\n",
        "    (\"fig05_mca_variable_map\",          \"Fig 5  — MCA Variable Map (Biplot)\"),\n",
        "    (\"fig06_mca_individual_map\",        \"Fig 6  — MCA Individual Map (before clustering)\"),\n",
        "    (\"fig07_cluster_validation\",        \"Fig 7  — Cluster Validation Indices (k=2 to 6)\"),\n",
        "    (\"fig08a_individual_map_CAH_centroids\",         \"Fig 8a — Individual Map CAH + Centroids\"),\n",
        "    (\"fig08b_individual_map_CAH_vs_KMeans\",         \"Fig 8b — Individual Map CAH vs K-Means\"),\n",
        "    (\"fig08c_biplot_individuals_modalities_centroids\",\"Fig 8c — Full Biplot: Individuals + Modalities + Centroids\"),\n",
        "    (\"fig09_cluster_profiles\",          \"Fig 9  — Thermo-Behavioral Cluster Profiles\"),\n",
        "    (\"fig10_bootstrap_stability\",       \"Fig 10 — Bootstrap Cluster Stability\"),\n",
        "    (\"fig11_cramers_v\",                 \"Fig 11 — Cramér's V (FDR-corrected)\"),\n",
        "    (\"fig12_spearman_correlations\",     \"Fig 12 — Spearman Correlations (FDR-corrected)\"),\n",
        "    (\"fig13_LDA\",                       \"Fig 13 — Linear Discriminant Analysis\"),\n",
        "    (\"fig14_odds_ratios\",               \"Fig 14 — Ordinal Logistic Regression: Odds Ratios\"),\n",
        "]\n",
        "\n",
        "# ── Check which figures exist ─────────────────────────────────────────────────\n",
        "print(\"=\" * 60)\n",
        "print(\"FIGURE STATUS\")\n",
        "print(\"=\" * 60)\n",
        "found, missing = [], []\n",
        "for name, title in ALL_FIGURES:\n",
        "    path = f\"/content/{name}.jpg\"\n",
        "    if os.path.exists(path):\n",
        "        size = os.path.getsize(path) / 1024\n",
        "        print(f\"  ✓  {title:<55} ({size:.0f} KB)\")\n",
        "        found.append((name, title, path))\n",
        "    else:\n",
        "        print(f\"  ✗  {title:<55} NOT FOUND\")\n",
        "        missing.append((name, title))\n",
        "\n",
        "print(f\"\\n  Found  : {len(found)} figures\")\n",
        "print(f\"  Missing: {len(missing)} figures\")\n",
        "\n",
        "if missing:\n",
        "    print(\"\\n  Missing figures — re-run the corresponding cells:\")\n",
        "    cell_map = {\n",
        "        \"fig01\": \"CELL 4\", \"fig02\": \"CELL 5\", \"fig03\": \"CELL 6\",\n",
        "        \"fig04\": \"CELL 8\", \"fig05\": \"CELL 9\", \"fig06\": \"CELL 10\",\n",
        "        \"fig07\": \"CELL 11\",\"fig08\": \"CELL C\", \"fig09\": \"CELL 15\",\n",
        "        \"fig10\": \"CELL 16\",\"fig11\": \"CELL A\", \"fig12\": \"CELL 18\",\n",
        "        \"fig13\": \"CELL B\", \"fig14\": \"CELL D\",\n",
        "    }\n",
        "    for name, title in missing:\n",
        "        prefix = name[:5]\n",
        "        cell   = cell_map.get(prefix, \"unknown cell\")\n",
        "        print(f\"    → {title}  →  re-run {cell}\")\n",
        "\n",
        "# ── Display all found figures inline ─────────────────────────────────────────\n",
        "if found:\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(\"DISPLAYING ALL FIGURES\")\n",
        "    print(\"=\" * 60)\n",
        "    for name, title, path in found:\n",
        "        print(f\"\\n{'─'*60}\")\n",
        "        print(f\"  {title}\")\n",
        "        print(f\"{'─'*60}\")\n",
        "        display(Image(filename=path, width=900))\n",
        "\n",
        "# ── Download options ──────────────────────────────────────────────────────────\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"DOWNLOAD OPTIONS\")\n",
        "print(\"=\" * 60)\n",
        "print(\"Choose one of the options below:\")\n",
        "print(\"  Option A — Download all figures one by one\")\n",
        "print(\"  Option B — Download as a ZIP archive\")\n",
        "print(\"  (run the corresponding block below)\")\n",
        "\n",
        "# ── OPTION A: Download one by one ────────────────────────────────────────────\n",
        "print(\"\\n--- OPTION A: individual download ---\")\n",
        "for name, title, path in found:\n",
        "    files.download(path)\n",
        "    print(f\"  downloaded: {name}.jpg\")"
      ],
