    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy.stats import chi2_contingency\n",
        "from statsmodels.stats.multitest import multipletests\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "def save(name):\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f\"/content/{name}.PNG\", format=\"PNG\", bbox_inches=\"tight\", dpi=150)\n",
        "    plt.close() # Close the figure to avoid displaying it multiple times in the notebook output\n",
        "    print(f\"saved: /content/{name}.PNG\")\n",
        "\n",
        "# ── CELL A ── Cramér's V\n",
        "def cramers_v(x, y):\n",
        "    ct = pd.crosstab(x, y)\n",
        "    chi2, p, dof, _ = chi2_contingency(ct)\n",
        "    n = ct.sum().sum(); r, k = ct.shape\n",
        "    return np.sqrt(chi2 / (n * (min(r, k) - 1))), p\n",
        "\n",
        "def cohen_lbl(v):\n",
        "    return \"negl.\" if v<0.10 else \"small\" if v<0.30 else \"medium\" if v<0.50 else \"large\"\n",
        "\n",
        "arch_v = {\n",
        "    \"Glazing type\"      : \"Glazing\",\n",
        "    \"Shutter state\"     : \"shutter_state\",\n",
        "    \"Roof state\"        : \"roof_state\",\n",
        "    \"Air infiltration\"  : \"air_infiltr\",\n",
        "    \"Water infiltration\": \"water_infiltr\",\n",
        "    \"Moisture/mold\"     : \"moisture\",\n",
        "    \"Cold drafts\"       : \"cold_drafts\",\n",
        "}\n",
        "tgt_v = {\n",
        "    \"Thermal sensation\"  : \"thermal_sensation\",\n",
        "    \"Summer satisfaction\": \"sat_summer\",\n",
        "    \"Winter satisfaction\": \"sat_winter\",\n",
        "    \"Cluster\"            : \"cluster_label\",\n",
        "}\n",
        "\n",
        "# Collect all 28 V and raw p-values\n",
        "rows_cv = []\n",
        "for a_l, a_c in arch_v.items():\n",
        "    for t_l, t_c in tgt_v.items():\n",
        "        tmp = ref[[a_c, t_c]].dropna()\n",
        "        if len(tmp) > 10 and a_c in ref.columns and t_c in ref.columns:\n",
        "            v, p = cramers_v(tmp[a_c], tmp[t_c])\n",
        "            rows_cv.append({\"Arch\": a_l, \"Target\": t_l,\n",
        "                             \"V\": round(v, 3), \"p_raw\": round(p, 4)})\n",
        "\n",
        "cv_df = pd.DataFrame(rows_cv)\n",
        "\n",
        "# FDR correction (Benjamini-Hochberg) on all 28 tests\n",
        "_, p_fdr, _, _ = multipletests(cv_df[\"p_raw\"].values, method=\"fdr_bh\")\n",
        "cv_df[\"p_FDR\"] = p_fdr.round(4)\n",
        "cv_df[\"sig\"]   = cv_df[\"p_FDR\"].apply(\n",
        "    lambda p: \"***\" if p<0.001 else \"**\" if p<0.01 else \"*\" if p<0.05 else \"ns\")\n",
        "cv_df[\"effect\"] = cv_df[\"V\"].apply(cohen_lbl)\n",
        "\n",
        "# Print table\n",
        "print(\"Cramér's V ─ Family F2 (FDR Benjamini-Hochberg, 28 tests)\")\n",
        "print(\"WARNING: Association != Causation\\n\")\n",
        "print(f\"{'Architectural var':<22} {'Target':<22} {'V':>5} \"\n",
        "      f\"{'p_raw':>8} {'p_FDR':>8} {'Sig':>5} {'Cohen':>7}\")\n",
        "print(\"─\" * 78)\n",
        "for _, row in cv_df.iterrows():\n",
        "    print(f\"{row['Arch']:<22} {row['Target']:<22} {row['V']:>5.3f} \"\n",
        "          f\"{row['p_raw']:>8.4f} {row['p_FDR']:>8.4f} \"\n",
        "          f\"{row['sig']:>5} {row['effect']:>7}\")\n",
        "\n",
        "n_ch = cv_df.apply(lambda r: (r[\"p_raw\"]<0.05) != (r[\"p_FDR\"]<0.05), axis=1).sum()\n",
        "print(f\"\\n→ {n_ch} associations change significance after FDR correction\")\n",
        "\n",
        "# Pivot for heatmap\n",
        "cv_pivot = cv_df.pivot(index=\"Arch\",   columns=\"Target\", values=\"V\")\n",
        "sig_piv  = cv_df.pivot(index=\"Arch\",   columns=\"Target\", values=\"sig\")\n",
        "eff_piv  = cv_df.pivot(index=\"Arch\",   columns=\"Target\", values=\"effect\")\n",
        "\n",
        "annot = cv_pivot.copy().astype(object)\n",
        "for i in range(annot.shape[0]):\n",
        "    for j in range(annot.shape[1]):\n",
        "        v = cv_pivot.iloc[i, j]\n",
        "        s = sig_piv.iloc[i, j]\n",
        "        e = eff_piv.iloc[i, j]\n",
        "        annot.iloc[i, j] = f\"{v:.2f}\\n({e})\\n{s}\"\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(12, 7))\n",
        "sns.heatmap(\n",
        "    cv_pivot.astype(float), annot=annot, fmt=\"\",\n",
        "    cmap=\"YlOrRd\", vmin=0, vmax=0.5, linewidths=0.6,\n",
        "    annot_kws={\"size\": 8}, ax=ax,\n",
        "    cbar_kws={\"label\": \"Cramér's V\", \"shrink\": 0.8}\n",
        ")\n",
        "fig.suptitle(\n",
        "    \"Figure 11 ─ Cramér's V: Architectural Variables × Thermal Comfort / Clusters\\n\"\n",
        "    \"Cohen benchmarks: <0.10 negl. · 0.10–0.30 small · 0.30–0.50 medium · >0.50 large\\n\"\n",
        "    \"p-values corrected by FDR (Benjamini-Hochberg, 28 tests)   \"\n",
        "    \"⚠ Association ≠ Causation\",\n",
        "    fontsize=9, fontweight=\"bold\"\n",
        ")\n",
        "ax.set_xticklabels(ax.get_xticklabels(), rotation=30, ha=\"right\", fontsize=9)\n",
        "ax.set_yticklabels(ax.get_yticklabels(), rotation=0, fontsize=9)\n",
        "ax.set_xlabel(\"\"); ax.set_ylabel(\"\")\n",
        "save(\"fig11_cramers_v\")"
      ],
