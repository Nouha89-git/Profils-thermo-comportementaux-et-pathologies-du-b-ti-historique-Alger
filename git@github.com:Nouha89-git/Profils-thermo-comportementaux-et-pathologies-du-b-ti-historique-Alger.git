    {
      "cell_type": "code",
      "source": [
        "pred_c = [\n",
        "    \"air_infiltr_b\",\n",
        "    \"cold_drafts_b\",\n",
        "    \"single_glaz_b\",\n",
        "    \"shutter_state_n\",\n",
        "    \"roof_state_n\",\n",
        "    \"beh_fan_ac\",\n",
        "    \"beh_heating\",\n",
        "    \"area\",\n",
        "]\n",
        "pred_l = {\n",
        "    \"air_infiltr_b\"  : \"Air infiltration\",\n",
        "    \"cold_drafts_b\"  : \"Cold drafts\",\n",
        "    \"single_glaz_b\"  : \"Single glazing\",\n",
        "    \"shutter_state_n\": \"Shutter state\",\n",
        "    \"roof_state_n\"   : \"Roof state\",\n",
        "    \"beh_fan_ac\"     : \"Fan / AC (summer)\",\n",
        "    \"beh_heating\"    : \"Heating (winter)\",\n",
        "    \"area\"           : \"Floor area (m²)\",\n",
        "}\n",
        "\n",
        "# ── Check available categories per season ────────────────────────────────────\n",
        "for season, dep in [(\"Summer\", \"sat_summer_n\"), (\"Winter\", \"sat_winter_n\")]:\n",
        "    reg = ref[pred_c + [dep]].dropna()\n",
        "    cats = sorted(reg[dep].unique().astype(int))\n",
        "    print(f\"{season}: N={len(reg)}  categories={cats}\")\n",
        "\n",
        "# ── Fit models ───────────────────────────────────────────────────────────────\n",
        "logit_r = {}\n",
        "\n",
        "for season, dep in [(\"Summer\", \"sat_summer_n\"), (\"Winter\", \"sat_winter_n\")]:\n",
        "    reg  = ref[pred_c + [dep]].dropna().copy()\n",
        "    cats = sorted(reg[dep].dropna().unique().astype(int))\n",
        "    reg[dep + \"_cat\"] = pd.Categorical(\n",
        "        reg[dep].astype(int), categories=cats, ordered=True\n",
        "    )\n",
        "    try:\n",
        "        model  = OrderedModel(\n",
        "            reg[dep + \"_cat\"],\n",
        "            reg[pred_c].astype(float),\n",
        "            distr=\"logit\"\n",
        "        )\n",
        "        result = model.fit(method=\"bfgs\", disp=False)\n",
        "        logit_r[season] = result\n",
        "\n",
        "        pr2 = 1 - result.llf / result.llnull\n",
        "        aic = result.aic\n",
        "        bic = result.bic\n",
        "\n",
        "        print(f\"\\n{'='*60}\")\n",
        "        print(f\"  {season} thermal satisfaction  (N={len(reg)})\")\n",
        "        print(f\"  McFadden pseudo-R² = {pr2:.4f}\")\n",
        "        print(f\"  AIC = {aic:.2f}   BIC = {bic:.2f}\")\n",
        "        print(f\"  [pseudo-R² reflects exploratory inference, not predictive fit]\")\n",
        "        print(f\"{'='*60}\")\n",
        "        print(f\"  {'Predictor':<22} {'OR':>6} {'95% CI Lo':>10} {'95% CI Hi':>10} \")\n",
        "        print(f\"  {'─'*58}\")\n",
        "\n",
        "        params = result.params[pred_c]\n",
        "        pvals  = result.pvalues[pred_c]\n",
        "        conf   = result.conf_int().loc[pred_c]\n",
        "\n",
        "        for v in pred_c:\n",
        "            or_v = np.exp(params[v])\n",
        "            lo   = np.exp(conf.loc[v, 0])\n",
        "            hi   = np.exp(conf.loc[v, 1])\n",
        "            p    = pvals[v]\n",
        "            sig  = (\"***\" if p < 0.001 else\n",
        "                    \"**\"  if p < 0.01  else\n",
        "                    \"*\"   if p < 0.05  else \"ns\")\n",
        "            flag = \"  ←\" if p < 0.05 else \"\"\n",
        "            print(f\"  {pred_l.get(v,v):<22} {or_v:>6.2f} \"\n",
        "                  f\"{lo:>10.2f} {hi:>10.2f} {p:>8.4f} {sig:>5}{flag}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"\\nError fitting {season} model: {e}\")\n",
        "\n",
        "# ── Figure: Odds Ratio forest plot (both seasons) ────────────────────────────\n",
        "if len(logit_r) == 2:\n",
        "\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(15, 7))\n",
        "\n",
        "    for ax, season, bar_color in [\n",
        "        (axes[0], \"Summer\", RED),\n",
        "        (axes[1], \"Winter\", STEEL),\n",
        "    ]:\n",
        "        result = logit_r[season]\n",
        "        params = result.params[pred_c]\n",
        "        pvals  = result.pvalues[pred_c]\n",
        "        conf   = result.conf_int().loc[pred_c]\n",
        "\n",
        "        or_v  = np.exp(params.values)\n",
        "        lo_v  = np.exp(conf.iloc[:, 0].values)\n",
        "        hi_v  = np.exp(conf.iloc[:, 1].values)\n",
        "        lbls  = [pred_l.get(v, v) for v in pred_c]\n",
        "        pv    = pvals.values\n",
        "\n",
        "        # Sort by OR value\n",
        "        idx  = np.argsort(or_v)\n",
        "        or_s = or_v[idx]; lo_s = lo_v[idx]; hi_s = hi_v[idx]\n",
        "        lb_s = [lbls[i] for i in idx]\n",
        "        pv_s = pv[idx]\n",
        "\n",
        "        # Color: significant = season color, non-significant = grey\n",
        "        colors = [bar_color if p < 0.05 else \"#cccccc\" for p in pv_s]\n",
        "\n",
        "        # Forest plot bars\n",
        "        ax.barh(\n",
        "            range(len(lb_s)), or_s - 1, left=1,\n",
        "            color=colors, edgecolor=\"white\", alpha=0.85, height=0.55\n",
        "        )\n",
        "\n",
        "        # Error bars (95% CI)\n",
        "        ax.errorbar(\n",
        "            or_s, range(len(lb_s)),\n",
        "            xerr=[or_s - lo_s, hi_s - or_s],\n",
        "            fmt=\"none\", color=\"black\", capsize=5, lw=1.3, capthick=1.3\n",
        "        )\n",
        "\n",
        "        # Reference line OR=1\n",
        "        ax.axvline(1, color=\"black\", lw=1.3, linestyle=\"--\", alpha=0.8)\n",
        "\n",
        "        # OR values and significance stars on the right\n",
        "        x_max = max(hi_s) * 1.05\n",
        "        for i, (ov, lo, hi, p) in enumerate(zip(or_s, lo_s, hi_s, pv_s)):\n",
        "            sig = (\"***\" if p < 0.001 else\n",
        "                   \"**\"  if p < 0.01  else\n",
        "                   \"*\"   if p < 0.05  else \"\")\n",
        "            txt = f\"{ov:.2f}{sig}\"\n",
        "            ax.text(\n",
        "                x_max, i, txt,\n",
        "                va=\"center\", ha=\"left\",\n",
        "                fontsize=8.5,\n",
        "                color=\"black\" if p < 0.05 else \"grey\",\n",
        "                fontweight=\"bold\" if p < 0.05 else \"normal\"\n",
        "            )\n",
        "\n",
        "        ax.set_yticks(range(len(lb_s)))\n",
        "        ax.set_yticklabels(lb_s, fontsize=9)\n",
        "        ax.set_xlabel(\"Odds Ratio (OR)\", fontsize=10)\n",
        "        ax.set_xlim(0, x_max * 1.25)\n",
        "\n",
        "        pr2 = 1 - result.llf / result.llnull\n",
        "        n   = len(ref[pred_c + [f\"sat_{season.lower()}_n\"]].dropna())\n",
        "\n",
        "        # Shade OR > 1 and OR < 1 zones lightly\n",
        "        xlim = ax.get_xlim()\n",
        "        ax.axvspan(xlim[0], 1, alpha=0.03, color=\"#1A5FA8\")  # OR < 1: protective\n",
        "        ax.axvspan(1, xlim[1], alpha=0.03, color=\"#D04B2F\")  # OR > 1: risk\n",
        "\n",
        "    # Shared legend\n",
        "    from matplotlib.lines import Line2D\n",
        "    legend_elements = [\n",
        "        mpatches.Patch(color=\"#D04B2F\", alpha=0.85, label=\"Significant (p<0.05) — Summer\"),\n",
        "        mpatches.Patch(color=\"#1A5FA8\", alpha=0.85, label=\"Significant (p<0.05) — Winter\"),\n",
        "        mpatches.Patch(color=\"#cccccc\", alpha=0.85, label=\"Non-significant (p≥0.05)\"),\n",
        "        Line2D([0],[0], color=\"black\", lw=1.3, linestyle=\"--\", label=\"OR = 1 (null effect)\"),\n",
        "    ]\n",
        "    fig.legend(\n",
        "        handles=legend_elements,\n",
        "        loc=\"lower center\", ncol=4,\n",
        "        fontsize=8.5, framealpha=0.9,\n",
        "        bbox_to_anchor=(0.5, -0.04)\n",
        "    )\n",
        "\n",
        "    plt.subplots_adjust(bottom=0.12, wspace=0.45)\n",
        "    save(\"fig14_odds_ratios\")\n",
        "\n",
        "# ── Model fit summary table ───────────────────────────────────────────────────\n",
        "print(\"\\n\" + \"=\"*55)\n",
        "print(\"MODEL FIT SUMMARY\")\n",
        "print(\"=\"*55)\n",
        "print(f\"{'Season':<10} {'N':>5} {'pseudo-R²':>12} {'AIC':>10} {'BIC':>10}\")\n",
        "print(\"─\"*50)\n",
        "for season, dep in [(\"Summer\",\"sat_summer_n\"),(\"Winter\",\"sat_winter_n\")]:\n",
        "    if season in logit_r:\n",
        "        r   = logit_r[season]\n",
        "        n   = len(ref[pred_c+[dep]].dropna())\n",
        "        pr2 = 1 - r.llf / r.llnull\n",
        "        print(f\"{season:<10} {n:>5} {pr2:>12.4f} {r.aic:>10.2f} {r.bic:>10.2f}\")\n",
        "\n",
        "print(f\"\"\"\n",
        "INTERPRETATION NOTE:\n",
        "  McFadden pseudo-R² < 0.10 = poor fit\n",
        "  McFadden pseudo-R² 0.10–0.20 = acceptable (Louviere et al., 2000)\n",
        "  McFadden pseudo-R² > 0.20 = good fit\n",
        "\n",
        "  Low pseudo-R² here reflects:\n",
        "    (1) Binary predictors have limited individual variance\n",
        "    (2) N=116 constrains model power\n",
        "  → Report OR direction and significance, not model as predictive tool.\n",
        "\"\"\")"
      ],
