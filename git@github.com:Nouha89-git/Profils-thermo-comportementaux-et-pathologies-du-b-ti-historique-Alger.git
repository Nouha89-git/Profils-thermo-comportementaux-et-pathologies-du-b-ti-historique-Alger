      },
      "source": [
        "# Régénération de la Figure 1 (Profil des répondants) avec titres\n",
        "fig, axes = plt.subplots(2, 3, figsize=(16, 10))\n",
        "fig.suptitle(\"Figure 1: Socio-demographic Respondent Profile\", fontsize=14, fontweight='bold', y=0.98)\n",
        "\n",
        "# Graphe 1 : Distribution par Genre\n",
        "vc = df[\"gender\"].value_counts()\n",
        "axes[0,0].pie(vc.values, labels=vc.index, autopct=\"%1.1f%%\", colors=[STEEL, RED, GREEN], startangle=90)\n",
        "axes[0,0].set_title(\"Gender Distribution\")\n",
        "\n",
        "# Graphe 2 : Statut d'Occupation\n",
        "vc2 = df[\"occupant_status\"].value_counts()\n",
        "bars = axes[0,1].barh(vc2.index, vc2.values, color=STEEL, edgecolor=\"white\")\n",
        "for bar, v in zip(bars, vc2.values):\n",
        "    axes[0,1].text(v+0.3, bar.get_y()+bar.get_height()/2, f\"{v} ({100*v/125:.1f}%)\", va=\"center\", fontsize=8)\n",
        "axes[0,1].set_xlim(0, vc2.max()*1.35)\n",
        "axes[0,1].set_title(\"Occupant Status\")\n",
        "\n",
        "# Graphe 3 : Distribution des Âges\n",
        "axes[0,2].hist(df[\"age\"].dropna(), bins=10, color=GREEN, edgecolor=\"white\")\n",
        "axes[0,2].axvline(df[\"age\"].mean(), color=RED, lw=1.5, linestyle=\"--\", label=f\"Mean={df['age'].mean():.1f} yr\")\n",
        "axes[0,2].set_xlabel(\"Age (years)\")\n",
        "axes[0,2].legend(fontsize=8)\n",
        "axes[0,2].set_title(\"Respondent Age Distribution\")\n",
        "\n",
        "# Graphe 4 : Surface Habitable\n",
        "axes[1,0].hist(df[\"area\"].dropna(), bins=10, color=RED, edgecolor=\"white\")\n",
        "axes[1,0].axvline(df[\"area\"].mean(), color=NAVY, lw=1.5, linestyle=\"--\", label=f\"Mean={df['area'].mean():.0f} m2\")\n",
        "axes[1,0].set_xlabel(\"Floor area (m2)\")\n",
        "axes[1,0].legend(fontsize=8)\n",
        "axes[1,0].set_title(\"Floor Area\")\n",
        "\n",
        "# Graphe 5 : Années d'Occupation\n",
        "axes[1,1].hist(df[\"occ_years\"].dropna(), bins=10, color=INDIGO, edgecolor=\"white\")\n",
        "axes[1,1].axvline(df[\"occ_years\"].mean(), color=RED, lw=1.5, linestyle=\"--\", label=f\"Mean={df['occ_years'].mean():.1f} yr\")\n",
        "axes[1,1].set_xlabel(\"Years of occupation\")\n",
        "axes[1,1].legend(fontsize=8)\n",
        "axes[1,1].set_title(\"Years of Occupation\")\n",
        "\n",
        "# Graphe 6 : Niveau de l'Étage\n",
        "vc3 = df[\"floor\"].value_counts().sort_index()\n",
        "axes[1,2].bar(vc3.index.astype(str), vc3.values, color=STEEL, edgecolor=\"white\")\n",
        "axes[1,2].set_xlabel(\"Floor level\")\n",
        "axes[1,2].set_title(\"Floor Level\")\n",
        "\n",
        "save(\"fig01_respondent_profile\")"
      ],
